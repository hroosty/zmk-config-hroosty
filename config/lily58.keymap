#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                          &kp N6  &kp N7    &kp N8      &kp N9   &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E     &kp R     &kp T                           &kp Y   &kp U     &kp I       &kp O    &kp P     &kp GRAVE
&kp LCTRL  &kp A   &kp S   &kp D     &kp F     &kp G                           &kp H   &kp J     &kp K       &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V     &kp B   &kp LBKT     &kp RBKT   &kp N   &kp M     &kp COMMA   &kp DOT  &kp FSLH  &kp RSHFT
                           &kp LALT  &kp LGUI  &mo 1   &kp SPACE    &kp SPACE  &mo 2   &kp BSPC  &kp DELETE
            >;
        };

        lower_layer {
            // --------------------------------------------------------------------------------------------------------------
            // | LPAD  | BRDn | BRUp |  MUT |  Vo- |  Vo+ |                   |      |       |       |      |       |       |
            // |  F1   |  F2  |  F3  |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !   |  @   |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |      |      |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                       |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp ESC           &trans    &trans    &kp C_AL_TASK_MANAGER  &kp C_AL_CALC  &kp C_SNAPSHOT                          &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT    &kp C_VOL_DN  &kp C_VOLUME_UP  &kp C_MUTE
&kp TAB           &trans    &trans    &trans                 &trans         &trans                                  &kp MINUS   &kp NUMBER_7      &kp NUMBER_8  &kp NUMBER_9  &kp KP_SLASH     &kp EQUAL
&kp LEFT_CONTROL  &kp LBRC  &kp RBRC  &kp LBKT               &kp RBKT       &trans                                  &kp PLUS    &kp N4            &kp NUMBER_5  &kp N6        &kp ASTERISK     &trans
&kp LEFT_SHIFT    &trans    &trans    &trans                 &trans         &trans          &kp LPAR     &kp RPAR   &kp N0      &kp N1            &kp N2        &kp N3        &kp DOT          &kp RIGHT_SHIFT
                                      &kp LEFT_ALT           &kp LGUI       &trans          &kp SPACE    &kp ENTER  &mo 3       &kp BSPC          &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp ESC           &trans  &kp PG_UP       &trans          &kp HOME   &studio_unlock                                                 &trans  &trans    &trans      &trans  &trans  &trans
&trans            &trans  &kp PG_DN       &kp UP_ARROW    &kp END    &trans                                                         &trans  &trans    &trans      &trans  &trans  &trans
&kp LEFT_CONTROL  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &trans                                                         &trans  &trans    &trans      &trans  &trans  &trans
&kp LEFT_SHIFT    &trans  &trans          &trans          &trans     &trans          &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &trans  &trans    &trans      &trans  &trans  &kp RIGHT_SHIFT
                                          &kp LEFT_ALT    &kp LGUI   &mo 3           &kp SPACE               &kp ENTER              &trans  &kp BSPC  &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Both {
            bindings = <
&kp ESC         &kp C_BRI_UP  &kp C_BRI_DN  &trans        &trans    &bt BT_CLR                                                 &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&kp TAB         &kp F1        &kp F2        &kp F3        &kp F4    &trans                                                     &trans        &trans         &trans        &trans        &trans        &trans
&kp LCTRL       &kp F5        &kp F6        &kp F7        &kp F8    &trans                                                     &trans        &trans         &trans        &trans        &trans        &trans
&kp LEFT_SHIFT  &kp F9        &kp F10       &kp F11       &kp F12   &trans      &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &trans        &trans         &trans        &trans        &trans        &kp RIGHT_SHIFT
                                            &kp LEFT_ALT  &kp LGUI  &trans      &kp SPACE               &kp ENTER              &trans        &kp BACKSPACE  &kp DELETE
            >;
        };
    };
};
