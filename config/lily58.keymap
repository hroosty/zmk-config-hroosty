#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4      &kp N5                          &kp N6  &kp N7    &kp N8        &kp N9   &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E     &kp R       &kp T                           &kp Y   &kp U     &kp I         &kp O    &kp P     &kp GRAVE
&kp LCTRL  &kp A   &kp S   &kp D     &kp F       &kp G                           &kp H   &kp J     &kp K         &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V       &kp B   &kp LBKT     &kp RBKT   &kp N   &kp M     &kp COMMA     &kp DOT  &kp FSLH  &kp RSHFT
                           &kp LALT  &kp DELETE  &mo 1   &kp SPACE    &kp SPACE  &mo 2   &kp BSPC  &kp LEFT_GUI
            >;
        };

        left {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp ESC           &trans     &trans          &trans          &trans      &trans                                                  &trans  &kp F10   &kp F11       &kp F12  &trans  &trans
&trans            &kp PG_DN  &kp PG_UP       &kp UP_ARROW    &kp HOME    &kp END                                                 &trans  &kp F7    &kp F8        &kp F9   &trans  &trans
&kp LEFT_CONTROL  &trans     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT   &trans                                                  &trans  &kp F4    &kp F5        &kp F6   &trans  &trans
&kp LEFT_SHIFT    &trans     &trans          &trans          &trans      &trans   &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &trans  &kp F1    &kp F2        &kp F3   &trans  &kp RIGHT_SHIFT
                                             &kp LEFT_ALT    &kp DELETE  &trans   &kp SPACE               &kp ENTER              &mo 3   &kp BSPC  &kp LEFT_GUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        right {
            // --------------------------------------------------------------------------------------------------------------
            // | LPAD  | BRDn | BRUp |  MUT |  Vo- |  Vo+ |                   |      |       |       |      |       |       |
            // |  F1   |  F2  |  F3  |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !   |  @   |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |      |      |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                       |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp ESC           &kp C_BRIGHTNESS_INC  &kp C_BRIGHTNESS_DEC  &kp C_AL_TASK_MANAGER  &kp C_AL_CALC  &kp C_SNAPSHOT                          &kp C_PP         &kp C_PREVIOUS   &kp C_NEXT       &kp C_VOL_DN     &kp C_VOLUME_UP  &kp C_MUTE
&kp TAB           &trans                &trans                &trans                 &trans         &trans                                  &kp MINUS        &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_SLASH     &kp BACKSLASH
&kp LEFT_CONTROL  &kp LBRC              &kp RBRC              &kp LBKT               &kp RBKT       &trans                                  &kp PLUS         &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK     &kp EQUAL
&kp LEFT_SHIFT    &trans                &trans                &trans                 &trans         &trans          &kp LPAR     &kp RPAR   &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp DOT          &kp RIGHT_SHIFT
                                                              &kp LEFT_ALT           &kp DELETE     &mo 3           &kp SPACE    &kp ENTER  &trans           &kp BSPC         &kp LEFT_GUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        both {
            bindings = <
&kp ESC         &trans  &trans  &trans        &trans      &studio_unlock                                                 &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&kp TAB         &trans  &trans  &trans        &trans      &trans                                                         &trans        &trans         &trans        &trans        &trans        &trans
&kp LCTRL       &trans  &trans  &trans        &trans      &trans                                                         &trans        &trans         &trans        &trans        &trans        &trans
&kp LEFT_SHIFT  &trans  &trans  &trans        &trans      &trans          &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &trans        &trans         &trans        &trans        &trans        &kp RIGHT_SHIFT
                                &kp LEFT_ALT  &kp DELETE  &trans          &kp SPACE               &kp ENTER              &trans        &kp BACKSPACE  &kp LEFT_GUI
            >;
        };
    };
};
